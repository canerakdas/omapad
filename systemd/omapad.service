[Unit]
Description=omapad - drive the desktop with a game controller
# What `systemctl help omapad` opens. A URL rather than a `man:` page
# because the manual is the README and there is no second copy of it.
Documentation=https://github.com/canerakdas/omapad#readme
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
ExecStart=__REPO__/bin/omapad run
Restart=on-failure
RestartSec=3

# The compositor's own variables are rediscovered at runtime, but the runtime
# directory is what makes that lookup possible in the first place.
Environment=XDG_RUNTIME_DIR=%t

[Install]
WantedBy=graphical-session.target
